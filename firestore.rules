rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos con acceso al panel (deben coincidir con ADMINS en assets/js/firebase.js).
    // Solo con correo y contraseña (cuenta creada por la organización).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in ['nestorquinapanta@gmail.com'];
    }

    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Ficha enviada por el corredor desde la web
    function validRegistration(d) {
      return d.keys().hasOnly(['nombre', 'cedula', 'nacimiento', 'sexo', 'distancia', 'categoria', 'talla',
                               'celular', 'correo', 'club', 'sangre', 'emergencia', 'codigo', 'cedulaKey', 'estado', 'creado'])
        && text(d.nombre, 3, 200) && text(d.cedula, 5, 200) && text(d.nacimiento, 10, 10)
        && d.sexo in ['Mujer', 'Hombre']
        && d.distancia in ['14K Jaguar', '7K Armadillo']
        && text(d.categoria, 1, 200)
        && d.talla in ['XS', 'S', 'M', 'L', 'XL', 'XXL']
        && text(d.celular, 7, 200) && text(d.correo, 5, 200) && d.correo.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && text(d.club, 0, 200) && text(d.sangre, 0, 200) && text(d.emergencia, 3, 200)
        && text(d.codigo, 9, 9) && text(d.cedulaKey, 5, 40)
        && d.estado == 'pendiente'
        && d.creado == request.time;
    }

    // Interruptor "Cerrar inscripciones" del panel. Si el documento no existe, están abiertas.
    function registrationOpen() {
      return !exists(/databases/$(database)/documents/config/inscripciones)
        || get(/databases/$(database)/documents/config/inscripciones).data.abiertas == true;
    }

    match /config/{doc} {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /inscripciones/{id} {
      allow create: if registrationOpen()
        && validRegistration(request.resource.data)
        && existsAfter(/databases/$(database)/documents/comprobantes/$(id));
      allow read, update, delete: if isAdmin();
    }

    // Consulta pública por cédula (página /verificar). Solo datos mínimos; el id del documento es la cédula
    // normalizada. Se puede leer un documento conociendo la cédula, pero no listar la colección.
    function validVerification(key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['ref', 'codigo', 'nombre', 'distancia', 'estado', 'actualizado'])
        && d.estado == 'pendiente'
        && d.actualizado == request.time
        && text(d.nombre, 1, 60) && text(d.ref, 10, 40)
        && existsAfter(/databases/$(database)/documents/inscripciones/$(d.ref))
        && getAfter(/databases/$(database)/documents/inscripciones/$(d.ref)).data.cedulaKey == key
        && getAfter(/databases/$(database)/documents/inscripciones/$(d.ref)).data.codigo == d.codigo
        && getAfter(/databases/$(database)/documents/inscripciones/$(d.ref)).data.distancia == d.distancia;
    }

    match /verificacion/{key} {
      allow get: if true;
      allow list: if isAdmin();
      // El corredor crea su registro al inscribirse; solo puede reemplazarlo si su inscripción anterior fue rechazada
      allow create: if isAdmin() || validVerification(key);
      allow update: if isAdmin() || (resource.data.estado == 'rechazada' && validVerification(key));
      allow delete: if isAdmin();
    }

    // Foto del comprobante (JPEG comprimido en el navegador, guardado aparte para no cargarlo en los listados)
    match /comprobantes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['imagen', 'creado'])
        && request.resource.data.imagen is string
        && request.resource.data.imagen.size() > 100
        && request.resource.data.imagen.size() < 1000000
        && request.resource.data.creado == request.time
        && existsAfter(/databases/$(database)/documents/inscripciones/$(id));
      allow read, delete: if isAdmin();
    }
  }
}
